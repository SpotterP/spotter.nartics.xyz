---
import { SITE } from "../config";
import {
  languages,
  defaultLang,
  localePath,
  withBase,
  useTranslations,
  type Lang,
} from "../i18n/ui";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
  /** Ruta de la página sin prefijo de idioma, p. ej. "/". Sin ella no se enlazan las otras versiones. */
  path?: string;
}

const { lang, image = "/og-image.png", path } = Astro.props;
const t = useTranslations(lang);
const title = Astro.props.title ?? t("site.title");
const description = Astro.props.description ?? t("site.description");

// Astro.site sale de astro.config.mjs (dominio propio o el de GitHub Pages).
const site = Astro.site ?? new URL(SITE.url);
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(withBase(image), site).href;
const langs = Object.keys(languages) as Lang[];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE.name,
  applicationCategory: "HealthApplication",
  operatingSystem: "Android, iOS, Web",
  inLanguage: langs,
  description,
  url: canonicalUrl,
};
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonicalUrl} />
{
  path &&
    langs.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(localePath(l, path), site).href} />
    ))
}
{
  path && (
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath(defaultLang, path), site).href}
    />
  )
}

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={languages[lang].og} />
{
  langs
    .filter((l) => l !== lang)
    .map((l) => <meta property="og:locale:alternate" content={languages[l].og} />)
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
